<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1>Афіша вистав</h1>
        </div>
        <% if (user && user.isAdmin) { %>
            <div class="col-auto">
                <a href="/admin/performances/add" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Додати виставу
                </a>
            </div>
        <% } %>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="GET" action="/performances" class="row g-3">
                <div class="col-md-4">
                    <label for="title" class="form-label">Назва вистави</label>
                    <input type="text" class="form-control" id="title" name="title" value="<%= searchParams?.title || '' %>">
                </div>
                <div class="col-md-3">
                    <label for="city" class="form-label">Місто</label>
                    <input type="text" class="form-control" id="city" name="city" value="<%= searchParams?.city || '' %>">
                </div>
                <div class="col-md-3">
                    <label for="date" class="form-label">Дата</label>
                    <input type="date" class="form-control" id="date" name="date" value="<%= searchParams?.date || '' %>">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Пошук
                    </button>
                </div>
            </form>
        </div>
    </div>

    <% if (performances.length === 0) { %>
        <div class="alert alert-info">
            На даний момент немає запланованих вистав.
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <% performances.forEach(performance => { %>
                <div class="col">
                    <div class="card h-100">
                        <img src="<%= performance.imageUrl %>" class="card-img-top" alt="<%= performance.title %>">
                        <div class="card-body">
                            <h5 class="card-title"><%= performance.title %></h5>
                            <div class="performance-details">
                                <p class="mb-2">
                                    <i class="bi bi-calendar-event"></i>
                                    <span class="performance-date" data-date="<%= performance.date.toISOString() %>"></span>
                                </p>
                                <p class="mb-2">
                                    <i class="bi bi-clock"></i>
                                    <%= performance.time %>
                                </p>
                                <p class="mb-2">
                                    <i class="bi bi-geo-alt"></i>
                                    <%= performance.venue %>
                                </p>
                            </div>

                            <div class="mt-3">
                                <h6 class="mb-2">Артисти:</h6>
                                <ul class="list-unstyled">
                                    <% performance.artists.forEach(artist => { %>
                                        <li><strong><%= artist.name %></strong> - <%= artist.role %></li>
                                    <% }) %>
                                </ul>
                            </div>

                            <div class="mt-3">
                                <h6 class="mb-2">Програма:</h6>
                                <p class="card-text"><%= performance.program %></p>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button class="btn btn-primary w-100 buy-ticket" data-performance-id="<%= performance._id %>">
                                <i class="bi bi-ticket-perforated"></i> Купити квиток
                            </button>
                        </div>
                        <% if (user && user.isAdmin) { %>
                            <div class="card-footer bg-transparent border-top-0">
                                <div class="d-flex justify-content-between">
                                    <button class="btn btn-outline-primary btn-sm" onclick="editPerformance('<%= performance._id %>')">
                                        <i class="bi bi-pencil"></i> Редагувати
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" onclick="deletePerformance('<%= performance._id %>')">
                                        <i class="bi bi-trash"></i> Видалити
                                    </button>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.performance-date').forEach(dateElement => {
        const date = new Date(dateElement.dataset.date);
        const options = { 
            weekday: 'long', 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
        };
        dateElement.textContent = date.toLocaleDateString('uk-UA', options);
    });
});

<% if (user && user.isAdmin) { %>
function editPerformance(id) {
    window.location.href = `/admin/performances/edit/${id}`;
}

function deletePerformance(id) {
    if (confirm('Ви впевнені, що хочете видалити цю виставу?')) {
        fetch(`/admin/performances/${id}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => {
            if (response.ok) {
                window.location.reload();
            } else {
                alert('Помилка при видаленні вистави');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Помилка при видаленні вистави');
        });
    }
}
<% } %>
</script>