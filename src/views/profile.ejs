<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h2 class="text-center">Профіль користувача</h2>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-circle" style="font-size: 4rem;"></i>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Ім'я:</strong>
                        </div>
                        <div class="col-md-8">
                            <%= user.name %>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Email:</strong>
                        </div>
                        <div class="col-md-8">
                            <%= user.email %>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a href="/auth/logout" class="btn btn-danger">Вийти</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>