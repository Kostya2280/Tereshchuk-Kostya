<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1>Купити квитки</h1>
        </div>
    </div>

    <% if (performances.length === 0) { %>
        <div class="alert alert-info">
            На даний момент немає запланованих вистав.
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <% performances.forEach(performance => { %>
                <div class="col">
                    <div class="card h-100">
                        <img src="<%= performance.imageUrl %>" class="card-img-top" alt="<%= performance.title %>">
                        <div class="card-body">
                            <h5 class="card-title"><%= performance.title %></h5>
                            <div class="performance-details">
                                <p class="mb-2">
                                    <i class="bi bi-calendar-event"></i>
                                    <span class="performance-date" data-date="<%= performance.date.toISOString() %>"></span>
                                </p>
                                <p class="mb-2">
                                    <i class="bi bi-clock"></i>
                                    <%= performance.time %>
                                </p>
                                <p class="mb-2">
                                    <i class="bi bi-geo-alt"></i>
                                    <%= performance.venue %>
                                </p>
                                <p class="mb-2">
                                    <i class="bi bi-ticket-perforated"></i>
                                    Доступно квитків: <%= performance.availableTickets %>
                                </p>
                                <p class="mb-2">
                                    <i class="bi bi-cash"></i>
                                    Ціна: <%= performance.ticketPrice %> грн
                                </p>
                            </div>
                        </div>
                        <div class="card-footer">
                            <% if (performance.availableTickets > 0) { %>
                                <a href="/tickets/book/<%= performance._id %>" class="btn btn-primary w-100">
                                    <i class="bi bi-ticket-perforated"></i> Вибрати місця
                                </a>
                            <% } else { %>
                                <button class="btn btn-secondary w-100" disabled>
                                    Квитки розпродано
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.performance-date').forEach(dateElement => {
        const date = new Date(dateElement.dataset.date);
        const options = { 
            weekday: 'long', 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
        };
        dateElement.textContent = date.toLocaleDateString('uk-UA', options);
    });
});
</script>